{
  "manifest_version": 3,
  "name": "Twitch Stream Helper",
  "version": "1.4.0",
  "description": "Keeps the Twitch chat input focused, auto-zooms Twitch to 75%, and reloads the tab (on a fast retry cadence) if the stream pauses, freezes, or gets stuck.",
  "permissions": ["storage"],
  "host_permissions": ["*://*.twitch.tv/*"],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "content_scripts": [
    {
      "matches": ["*://*.twitch.tv/*"],
      "js": ["content.js", "watchdog.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
